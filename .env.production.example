# Producción — NO commitear el archivo real.
# En el droplet: copiar a un path fuera del repo (p. ej. /etc/elohimcoban.env)
#   sudo cp .env.production.example /etc/elohimcoban.env
#   sudo chmod 600 /etc/elohimcoban.env
#   sudo nano /etc/elohimcoban.env
#
# Referencia en systemd (ver deploy/gunicorn.service.example):
#   EnvironmentFile=/etc/elohimcoban.env
#   Environment=DJANGO_ENV_FILE=/etc/elohimcoban.env
#
# O bien: exportar las mismas variables en el entorno del servicio gunicorn.

# Django
SECRET_KEY=genera-una-clave-secreta-larga-y-unica-nunca-la-compartas
DEBUG=False
# IP del droplet y, cuando exista, tu dominio (coma, sin espacios)
ALLOWED_HOSTS=127.0.0.1,TU_IP_PUBLICA,TU_DOMINIO_OPCIONAL

# Base de datos en el mismo servidor o gestionada (RDS, etc.)
DB_NAME=elohimcoban_db
DB_USER=elohimcoban
DB_PASSWORD=password-seguro-de-produccion
DB_HOST=localhost
DB_PORT=5432

# Origen del frontend en producción (mismo esquema/host que sirve el build de React)
# Ejemplo con dominio: https://cursos.tudominio.com
CORS_ALLOWED_ORIGINS=https://TU_DOMINIO_O_IP
CSRF_TRUSTED_ORIGINS=https://TU_DOMINIO_O_IP
