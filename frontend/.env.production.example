# Build de producción: copiar a .env.production antes de npm run build
# cp .env.production.example .env.production
#
# Debe coincidir con la URL pública desde el navegador (mismo host que Nginx).
# Si todo va por el mismo dominio con /api:
# REACT_APP_API_URL=https://tudominio.com/api
#
# Ajusta esquema (http/https) y host cuando el dominio esté configurado.

REACT_APP_API_URL=https://TU_DOMINIO_O_IP/api
