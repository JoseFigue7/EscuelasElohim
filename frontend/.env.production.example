# Build de producción: copiar a .env.production antes de npm run build
# cp .env.production.example .env.production
#
# Mismo host y esquema que Nginx (evita "mixed active content" si el sitio es HTTPS y la API apuntaba a http://IP).
# Recomendado: ruta relativa; el bundle usará https://tudominio.com/api/... o http://IP/api/... según desde dónde entres.
REACT_APP_API_URL=/api
# Solo si el SPA y el backend viven en orígenes distintos: REACT_APP_API_URL=https://tudominio.com/api
