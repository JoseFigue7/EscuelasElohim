# Sustituir __REPO__ por la ruta del clon, p. ej.:
#   sed "s|__REPO__|/var/www/elohim/EscuelasElohim|g" deploy/nginx.conf.example | sudo tee /etc/nginx/sites-available/elohimcoban
#   sudo ln -sf /etc/nginx/sites-available/elohimcoban /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Importante: CRA (React) sirve assets en /static/js/ y /static/css/. Django
# también usa /static/ (admin, DRF). Por eso /static/admin/ y
# /static/rest_framework/ van a collectstatic y el resto de /static/ al build.

upstream elohimcoban_app {
    server unix:/run/gunicorn/elohimcoban.sock fail_timeout=0;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 25M;

    location ^~ /static/admin/ {
        alias __REPO__/backend/staticfiles/admin/;
    }

    location ^~ /static/rest_framework/ {
        alias __REPO__/backend/staticfiles/rest_framework/;
    }

    location ^~ /static/ {
        alias __REPO__/frontend/build/static/;
    }

    location /media/ {
        alias __REPO__/backend/media/;
    }

    location /api/ {
        proxy_pass http://elohimcoban_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://elohimcoban_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root __REPO__/frontend/build;
        try_files $uri $uri/ /index.html;
    }
}
